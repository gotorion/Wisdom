---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  bodyClass?: string;
}

const {
  title,
  description = '别人讲过的、真的击中过我的话。每条都带着出处。',
  bodyClass,
} = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body class={bodyClass}>
    <nav class="nav" id="site-nav" aria-label="主导航">
      <a class="nav__brand" href={`${base}/`}>BeHappy</a>
      <div class="nav__links">
        <a href={`${base}/#entries`}>条目</a>
        <a href={`${base}/#themes`}>主题</a>
        <a href="https://github.com/gotorion/Wisdom" rel="noopener">GitHub</a>
      </div>
    </nav>

    <slot />

    <script>
      const nav = document.getElementById('site-nav');
      if (nav) {
        const chapters = Array.from(document.querySelectorAll('[data-bg]'));
        let frame = 0;

        const paint = () => {
          frame = 0;
          const y = nav.offsetHeight * 0.5;
          let current = chapters[0];
          for (const el of chapters) {
            const rect = el.getBoundingClientRect();
            if (rect.top <= y && rect.bottom > y) {
              current = el;
              break;
            }
          }
          if (current) {
            nav.style.backgroundColor = current.dataset.bg;
            nav.style.color = current.dataset.ink;
          }
        };

        const schedule = () => {
          if (!frame) frame = requestAnimationFrame(paint);
        };

        paint();
        addEventListener('scroll', schedule, { passive: true });
        addEventListener('resize', schedule);
      }

      const reveals = document.querySelectorAll('.reveal');
      if (reveals.length && 'IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-in');
                io.unobserve(entry.target);
              }
            }
          },
          { rootMargin: '0px 0px -12% 0px' },
        );
        reveals.forEach((el) => io.observe(el));
        // Safety net: never leave content invisible, whatever the scroll or capture does.
        setTimeout(() => reveals.forEach((el) => el.classList.add('is-in')), 2400);
      } else {
        reveals.forEach((el) => el.classList.add('is-in'));
      }
    </script>
  </body>
</html>
